generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  handle       String   @unique
  orcid        String?  @unique
  bio          String?
  role         String   @default("researcher")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
